{
  "expo": {
    "name": "HidroSmart",
    "slug": "hidrosmart-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": { "edgeToEdgeEnabled": false, "usesCleartextTraffic": true },
    "androidNavigationBar": {
      "backgroundColor": "#020617",
      "barStyle": "light-content"
    },
    "web": { "bundler": "metro" }
  }
}
