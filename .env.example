# Variables locales para Docker Compose. Nunca uses estos valores en produccion.
NODE_ENV=development
APP_TIMEZONE=America/Bogota
POSTGRES_DB=hidro_smart
POSTGRES_USER=hidro_smart_admin
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA_ADMIN
POSTGRES_HOST=localhost
POSTGRES_INTERNAL_HOST=postgres
POSTGRES_INTERNAL_PORT=5432
POSTGRES_LOCAL_HOST=localhost
POSTGRES_LOCAL_PORT=5433
POSTGRES_PORT=5433

DB_HOST=postgres
# PostgreSQL de Docker es local; se mantiene sin SSL salvo configuración explícita.
DB_SSL=false
DB_DOCKER_HOST=host.docker.internal
DB_DOCKER_PORT=5433
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=5433
DB_PORT=5432
DB_NAME=hidro_smart
DB_USER=hidro_smart_app
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_APP
DB_POOL_MAX=10
DB_INGEST_USER=hidro_smart_ingest
DB_INGEST_PASSWORD=CAMBIA_ESTA_CONTRASENA_INGEST
DB_INGEST_POOL_MAX=5

LIQUIBASE_USER=hidro_smart_liquibase
LIQUIBASE_PASSWORD=CAMBIA_ESTA_CONTRASENA_LIQUIBASE

BACKEND_PORT=3000
FRONTEND_PORT=5173
CORS_ORIGIN=http://localhost:5173,http://localhost
# Root compose routes browser traffic through its Nginx frontend.
TRUST_PROXY_HOPS=1

MATERIALIZED_VIEWS_REFRESH_MS=300000
ALERT_GENERATION_INTERVAL_MS=300000
AUDIT_CLEANUP_INTERVAL_MS=86400000
AUDIT_RETENTION_DAYS=365
AUDIT_CLEANUP_BATCH_SIZE=1000
ACTUATOR_COMMAND_TIMEOUT_MS=60000
ACTUATOR_COMMAND_TIMEOUT_BATCH_SIZE=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Cuota por cuenta para login y recuperacion; evita intentos repetidos.
AUTH_RATE_LIMIT_MAX=20
# Techo por IP para rutas publicas; permite usuarios de una red compartida.
AUTH_RATE_LIMIT_IP_MAX=1000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=app.tu-dominio.local

JWT_SECRET=CAMBIA_ESTE_SECRETO_JWT_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=hidro-smart-api
JWT_AUDIENCE=hidro-smart-web


FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_URL=http://localhost:5173/login
VITE_API_URL=/api/v1

# Proveedor único para los correos transaccionales. BREVO_API_KEY debe ser API v3
# (xkeysib-...), no la clave SMTP (xsmtpsib-); el remitente debe estar verificado.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=HidroSmart

# MQTT: el backend integrado usa mqtt://mosquitto:1883;
# el backend ejecutado directamente desde Windows usa localhost:1883.
MQTT_PORT=1883
# Host que recibe el ESP32 fuera de Docker. Debe ser un nombre DNS estable de
# la red Wi-Fi (configurado en el router); nunca uses el nombre interno "mosquitto".
MQTT_DEVICE_HOST=hidrosmart-broker.local
MQTT_DEVICE_PORT=1883
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_DOCKER_BROKER_URL=mqtt://mosquitto:1883
MQTT_LOCAL_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=hidrosmart-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1
# Render production example (set in Render secrets, not in this local .env):
# MQTT_BROKER_URL=mqtts://mqtt.flespi.io:8883
# MQTT_USERNAME=<dedicated Flespi token with ACL>
# For a device provisioned against Flespi, set its public endpoint in the
# build environment too; the local Docker profile above intentionally stays local.
# MQTT_DEVICE_HOST=mqtt.flespi.io
# MQTT_DEVICE_PORT=8883
# Set true only while migrating legacy ESP32 firmware without mqttMessageId.
MQTT_ALLOW_LEGACY_TELEMETRY=false
MQTT_RECONNECT_PERIOD_MS=3000
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_MAX_PAYLOAD_BYTES=16384

# Solo pruebas de integracion. No son necesarias para levantar la aplicacion.
# Define estas variables en la sesion de PowerShell antes de seed:integration.
# INTEGRATION_ADMIN_DATABASE_URL=postgresql://hidro_smart_admin:CLAVE_ADMIN@localhost:5433/hidro_smart
# INTEGRATION_ADMIN_EMAIL=ci-administrator@hidrosmart.local
# INTEGRATION_ADMIN_PASSWORD=CAMBIA_ESTA_CLAVE
# INTEGRATION_HOMEUSER_EMAIL=ci-homeuser@hidrosmart.local
# INTEGRATION_HOMEUSER_PASSWORD=CAMBIA_ESTA_CLAVE
# INTEGRATION_GUEST_EMAIL=ci-guest@hidrosmart.local
# INTEGRATION_GUEST_PASSWORD=CAMBIA_ESTA_CLAVE
