# Plantilla para ejecutar BK_HS directamente en Windows o en su Compose propio.
# Directo: PostgreSQL localhost:5433 y MQTT localhost:1883.
# Docker propio: PostgreSQL host.docker.internal:5433 y MQTT mosquitto:1883.
NODE_ENV=development
PORT=3000
BACKEND_PORT=3000
CORS_ORIGIN=http://localhost:5173
MATERIALIZED_VIEWS_REFRESH_MS=300000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_IP_MAX=1000
APP_TIMEZONE=America/Bogota
ALERT_GENERATION_INTERVAL_MS=300000
AUDIT_CLEANUP_INTERVAL_MS=86400000
AUDIT_RETENTION_DAYS=365
AUDIT_CLEANUP_BATCH_SIZE=1000
ACTUATOR_COMMAND_TIMEOUT_MS=60000
ACTUATOR_COMMAND_TIMEOUT_BATCH_SIZE=100

DB_HOST=localhost
# Solo local. Si reutilizas este archivo en Render/Neon, cambia DB_SSL a true.
DB_SSL=false
# Solo para el backend dentro de BK_HS/docker-compose.yml.
DB_DOCKER_HOST=host.docker.internal
DB_DOCKER_PORT=5433
DB_PORT=5433
DB_NAME=hidro_smart
DB_USER=hidro_smart_app
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA_APP
DB_POOL_MAX=10
DB_INGEST_USER=hidro_smart_ingest
DB_INGEST_PASSWORD=CAMBIA_ESTA_CONTRASENA_INGEST
DB_INGEST_POOL_MAX=5

JWT_SECRET=CAMBIA_ESTE_SECRETO_LARGO
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=hidro-smart-api
JWT_AUDIENCE=hidro-smart-web

FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_URL=http://localhost:5173/login
# Brevo is the only transactional email provider. Use a v3 API key
# (xkeysib-...), not the SMTP key (xsmtpsib-...), and a verified sender.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=HidroSmart

# MQTT (ejecución del backend fuera de Docker)
MQTT_PORT=1883
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_DOCKER_BROKER_URL=mqtt://mosquitto:1883
MQTT_CLIENT_ID=hidrosmart-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1
MQTT_ALLOW_LEGACY_TELEMETRY=true
MQTT_RECONNECT_PERIOD_MS=3000
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_MAX_PAYLOAD_BYTES=16384

# Integración opcional de roles/RLS. No son credenciales de producción.
# RUN_INTEGRATION=1
# INTEGRATION_DATABASE_URL=postgresql://hidro_smart_app:CAMBIA_ESTA_CONTRASENA_APP@localhost:5433/hidro_smart
# INTEGRATION_ADMIN_EMAIL=
# INTEGRATION_ADMIN_PASSWORD=
# INTEGRATION_HOMEUSER_EMAIL=
# INTEGRATION_HOMEUSER_PASSWORD=
# INTEGRATION_GUEST_EMAIL=
# INTEGRATION_GUEST_PASSWORD=
