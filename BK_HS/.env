# Configuracion local del backend
NODE_ENV=development
PORT=3000
BACKEND_PORT=3000
APP_TIMEZONE=America/Bogota
ALERT_GENERATION_INTERVAL_MS=300000
AUDIT_CLEANUP_INTERVAL_MS=86400000
AUDIT_RETENTION_DAYS=365
AUDIT_CLEANUP_BATCH_SIZE=1000
ACTUATOR_COMMAND_TIMEOUT_MS=60000
ACTUATOR_COMMAND_TIMEOUT_BATCH_SIZE=100
MATERIALIZED_VIEWS_REFRESH_MS=300000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Base de datos local
DB_HOST=localhost
DB_DOCKER_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=hidro_smart
DB_USER=hidro_smart_app
DB_PASSWORD=HidroSmartAppLocal2026_9!
DB_INGEST_USER=hidro_smart_ingest
DB_INGEST_PASSWORD=HidroSmartIngestLocal2026_9!
DB_INGEST_POOL_MAX=5
DB_POOL_MAX=10

# JWT
JWT_SECRET=HidroSmart.Jwt.Local.2026.09.13.OnlyForDevelopment.7f3c9a2d!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=hidro-smart-api
JWT_AUDIENCE=hidro-smart-web

# Frontend y CORS
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_URL=http://localhost:5173/login
CORS_ORIGIN=http://localhost:5173,http://localhost

# MQTT local (backend ejecutado directamente desde Windows)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_DOCKER_BROKER_URL=mqtt://mosquitto:1883
MQTT_CLIENT_ID=hidrosmart-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1
MQTT_RECONNECT_PERIOD_MS=3000
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_MAX_PAYLOAD_BYTES=16384

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
